<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="TeclazoWindow" parent="AdwApplicationWindow">
    <property name="title">Teclazo</property>
    <property name="width-request">1000</property>
    <property name="height-request">900</property>
    <property name="default-width">1000</property>
    <property name="default-height">900</property>
    <property name="content">
      <object class="AdwNavigationView" id="navigation_view">
        <child>
          <object class="WelcomeView" id="welcome_view_widget"/>
        </child>
        <child>
          <object class="TeclazoLessonsView" id="lessons_view_widget"/>
        </child>
        <child>
          <object class="LessonView" id="lesson_view_widget"/>
        </child>
      </object>
    </property>
  </template>
</interface>
