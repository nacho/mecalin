#: data/io.github.nacho.mecalin.desktop.in:3
msgid "Mecalin"
msgstr "Mecalin"

#: data/io.github.nacho.mecalin.desktop.in:4
msgid "Learn how to type"
msgstr "Aprende a escribir"

#: data/io.github.nacho.mecalin.desktop.in:10
msgid "keyboard;touch type;touch typing;typing;typing tutor;"
msgstr "teclado;mecanografía;escribir;tutor de mecanografía;"

#: resources/ui/course_completion_view.ui:4
msgid "Course Completed"
msgstr "Curso completado"

#: resources/ui/course_completion_view.ui:13
msgid "Congratulations!"
msgstr "¡Enhorabuena!"

#: resources/ui/course_completion_view.ui:14
msgid ""
"You've completed all lessons! Keep practicing to improve your typing skills."
msgstr ""
"¡Has completado todas las lecciones! Sigue practicando para mejorar tus "
"habilidades de escritura."

#: resources/ui/course_completion_view.ui:21
msgid "Keypunch"
msgstr "Keypunch"

#: resources/ui/course_completion_view.ui:22
msgid "Practice your typing speed"
msgstr "Practica tu velocidad de tecleo"

#: resources/ui/lesson_view.ui:96 src/lessons_view.rs:111
msgid "Continue"
msgstr "Continuar"

#: resources/ui/lessons_view.ui:6
msgid "_Preferences"
msgstr "_Preferencias"

#: resources/ui/lessons_view.ui:10
msgid "_About Mecalin"
msgstr "_Acerca de Mecalin"

#: resources/ui/lessons_view.ui:17
msgid "Lessons"
msgstr "Lecciones"

#: resources/ui/lessons_view.ui:25
msgid "Main Menu"
msgstr "Menú principal"

#: resources/ui/welcome_view.ui:5
msgid "Welcome"
msgstr "Bienvenido"

#: resources/ui/welcome_view.ui:25
msgid "Welcome to Mecalin"
msgstr "Bienvenido a Mecalin"

#: resources/ui/welcome_view.ui:26
msgid ""
"Your personal typing tutor. Learn to type quickly and accurately, one step "
"at a time."
msgstr ""
"Tu tutor de mecanografía personal. Aprende a teclear con rapidez y "
"precisión, paso a paso."

#: resources/ui/welcome_view.ui:37
msgid "Learn Touch Typing"
msgstr "Aprende mecanografía al tacto"

#: resources/ui/welcome_view.ui:38
msgid ""
"Structured lessons guide you from the home row to the whole keyboard. An on-"
"screen keyboard and hand guide show you which finger to use for every key."
msgstr ""
"Las lecciones estructuradas te guían desde la fila base hasta todo el "
"teclado. Un teclado en pantalla y una guía de manos te muestran qué dedo "
"usar para cada tecla."

#: resources/ui/welcome_view.ui:49
msgid "Practice at Your Own Pace"
msgstr "Practica a tu propio ritmo"

#: resources/ui/welcome_view.ui:50
msgid ""
"Take your time and practice regularly. Your progress is saved automatically, "
"so you can always pick up where you left off."
msgstr ""
"Tómate tu tiempo y practica con regularidad. Tu progreso se guarda "
"automáticamente, así que siempre puedes continuar donde lo dejaste."

#: resources/ui/welcome_view.ui:72
msgid "_Continue"
msgstr "_Continuar"

#: resources/ui/welcome_view.ui:82
msgid "_Get Started"
msgstr "_Empezar"

#: src/lessons_view.rs:69
msgid "Your system keyboard layout isn’t supported yet — showing US English"
msgstr ""
"Tu distribución de teclado aún no es compatible: se muestra inglés de EE. UU."

#: src/lessons_view.rs:138
msgid "Current lesson"
msgstr "Lección actual"

#: src/preferences_dialog.rs:15
msgid "Display"
msgstr "Visualización"

#: src/preferences_dialog.rs:19
msgid "Show Hand Widget"
msgstr "Mostrar control de manos"

#: src/preferences_dialog.rs:20
msgid "Display finger position guide"
msgstr "Mostrar guía de posición de dedos"

#: src/preferences_dialog.rs:23
msgid "Use Finger Colors"
msgstr "Usar colores de dedos"

#: src/preferences_dialog.rs:24
msgid "Color keyboard keys and hand by finger assignment"
msgstr "Colorear las teclas del teclado y la mano según la asignación de dedos"
